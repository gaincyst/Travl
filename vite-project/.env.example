# ========================================
# Frontend Environment Variables
# ========================================

# Backend API URL
# For LOCAL development: http://localhost:5000/api
# For PRODUCTION: Replace with your deployed backend URL
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Web Client ID (same value used by backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Instructions:
# 1. Copy this file to .env for local development
# 2. Update VITE_API_BASE_URL with your actual backend URL
# 3. Add VITE_GOOGLE_CLIENT_ID from Google Cloud Console
# 4. For production builds, use .env.production
